# SupplySense environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supplysense
DB_USER=supplysense
DB_PASSWORD=supplysense_dev_pw

# --- AI Copilot (Phase 4) ---
# Any one of these may be used depending on availability.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
