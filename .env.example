# SupplySense environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supplysense
DB_USER=supplysense
DB_PASSWORD=supplysense_dev_pw
# Set to "require" for hosted Postgres providers (Neon, Supabase, RDS, etc.)
# that mandate SSL. Leave blank for local/Docker Postgres.
DB_SSLMODE=

# --- AI Copilot (Phase 4) ---
# Set ONE of these (whichever provider you want to use):
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: force a specific provider instead of auto-detecting from the
# keys above ("anthropic" or "gemini"). Leave blank to auto-detect.
LLM_PROVIDER=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
